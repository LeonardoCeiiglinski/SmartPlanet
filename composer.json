{
  "name": "smartplanet/erp-pdv",
  "description": "ERP e PDV SmartPlanet com impressão térmica 33x21 mm",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "migrate": "php bin/migrate.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
