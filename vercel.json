{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "includeFiles": "{app,bin,database,public,css,js,api}/**",
      "excludeFiles": "{storage,tests,.git}/**"
    }
  },
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/public/assets/:path*" },
    { "source": "/favicon.png", "destination": "/public/favicon.png" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
