{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "includeFiles": "{app,bin,database,public,css,js,api}/**",
      "excludeFiles": "{storage,tests,.git}/**"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/favicon\\.png", "dest": "/public/favicon.png" },
    { "src": "/favicon\\.ico", "dest": "/public/favicon.png" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
