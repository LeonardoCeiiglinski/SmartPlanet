{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "includeFiles": "{app,public}/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "pdv.lojadeletronicossaojose.com.br" }],
      "dest": "https://smart-planet-rouge.vercel.app/$1"
    },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
