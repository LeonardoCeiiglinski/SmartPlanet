{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "includeFiles": "{app,bin,database,public,css,js,website}/**",
      "excludeFiles": "{storage,tests,.git,public/srv,website/.vercel}/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
