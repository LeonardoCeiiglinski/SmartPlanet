{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "includeFiles": "srv/**"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.png" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
