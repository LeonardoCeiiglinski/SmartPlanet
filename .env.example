APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres

# Desenvolvimento imediato, sem instalar um servidor:
DB_DRIVER=sqlite
DB_DATABASE=storage/app/erp.sqlite

# Produção / Vercel: MySQL persistente (PlanetScale, Railway, Aiven, TiDB Cloud).
# DB_DRIVER=mysql
# DATABASE_URL=mysql://usuario:senha@host:3306/banco
# DB_SSL=true
# AUTO_MIGRATE=true
# INSTALL_COMPANY=SmartPlanet
# INSTALL_EMAIL=admin@empresa.com
# INSTALL_PASSWORD=senha-com-10-ou-mais
# INSTALL_NAME=Administrador
# SESSION_DRIVER=database
# SESSION_SECURE=true

SESSION_NAME=erp_pdv_session
SESSION_SECURE=false
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=ERP PDV
