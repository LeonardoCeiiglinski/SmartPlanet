APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres

# Desenvolvimento imediato, sem instalar um servidor:
DB_DRIVER=sqlite
DB_DATABASE=storage/app/erp.sqlite

# Produção MySQL/MariaDB:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=erp_pdv
# DB_USERNAME=erp_user
# DB_PASSWORD=senha-forte

SESSION_NAME=erp_pdv_session
SESSION_SECURE=false
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=ERP PDV
